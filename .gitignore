# Project-local environments, tools, caches and machine configuration
/.venv*/
/.envs/
/.cache/
/.tmp/
/.config/
/.local/
__pycache__/
*.py[cod]
.pytest_cache/

# External assets: preserved locally; see configs/external-assets.json
/third_party/
/data/
/models/

# Keep lightweight run metadata; omit generated binaries and model fields
/experiments/**
!/experiments/**/
!/experiments/**/*.json
!/experiments/**/*.inp
!/experiments/**/*.f90
*.o
*.mod
*.so
*.a

# Keep audit summaries and test logs, omit other transient logs
/logs/**
!/logs/*.json
!/logs/tiegcm2023_all_tests.log
!/logs/tiegcm2023_startup_10min_v1.log
!/logs/tiegcm2023_startup_all_tests.log
!/logs/tiegcm2023_startup_static_tests.log
!/logs/tiegcm2023_restart_all_tests.log
!/logs/tiegcm2023_restart_static.log
!/logs/tiegcm2023_crossday_24h10_v1.log
!/logs/tiegcm2023_crossday_all_tests.log
!/logs/tiegcm2023_crossday_static_tests.log

# Credentials and editor/OS files
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.DS_Store
.vscode/

!/logs/tiegcm2023_continuation_v1_B1.log
!/logs/tiegcm2023_continuation_all_tests.log
!/logs/tiegcm2023_continuation_static_tests.log

!/logs/tiegcm2023_s3_continuous_v1.log
!/logs/tiegcm2023_s3_all_tests_final.log
!/logs/tiegcm2023_s3_static_tests.log

!/logs/tiegcm2023_s3_delivery_tests.log
!/logs/tiegcm2023_s3_audit.log

# S7 single-run and offline comparison evidence
!/logs/tiegcm2023_s7_static_tests.log
!/logs/tiegcm2023_s7_all_tests.log
!/logs/tiegcm2023_s7_audit.log
!/logs/tiegcm2023_s7_continuous_v1.log
!/logs/tiegcm2023_s3_s7_comparison.log
!/logs/tiegcm2023_s3_s7_regional_trends.log
!/logs/tiegcm2023_comparison_tests.log
!/logs/tiegcm2023_s3_s7_delivery_tests.log

# Native density API test and offline audit evidence
!/logs/tiegcm_density*.log

# Explicitly provisional coordinate / offline trajectory query evidence
!/logs/provisional_adapter_tests.log
!/logs/swarm_provisional*.log

# Research-only RK45 drag integration evidence (raw traces remain under data/)
!/logs/provisional_drag*.log

# Offline NRLMSIS validation logs
!/logs/nrlmsis*.log
