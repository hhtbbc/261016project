{"created": "2026-09-02T09:42:32.131960+00:00", "modified": "2026-09-02T09:42:32.865083+00:00", "id": 22250238, "conceptrecid": "22250237", "doi": "10.5281/zenodo.22250238", "conceptdoi": "10.5281/zenodo.22250237", "doi_url": "https://doi.org/10.5281/zenodo.22250238", "metadata": {"title": "AFNO Software for TIE-GCM-Based Multivariable Thermospheric State Forecasting", "doi": "10.5281/zenodo.22250238", "publication_date": "2026-09-02", "description": "<p>This software record contains the implementation of the Adaptive Fourier Neural Operator (AFNO) framework developed for multivariable thermospheric state forecasting based on TIE-GCM simulations. The archived materials include the source code for model implementation, inference, and evaluation; the trained model checkpoint; and the normalization files required to reproduce the inference experiments. See the ReadMe.md file for more details in FourCastDen.zip. The software is intended for use with the separately archived 2023 TIE-GCM simulation dataset. The source code and associated software materials are released under the Apache License 2.0.</p>\n<p>&nbsp;</p>\n<pre>&nbsp;</pre>", "access_right": "open", "creators": [{"name": "Zhou, shuyang", "affiliation": null}, {"name": "He, Changyong", "affiliation": "Hunan University of Science and Technology", "orcid": "0000-0002-8438-0631"}], "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "apache2.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22250237"}}]}}, "title": "AFNO Software for TIE-GCM-Based Multivariable Thermospheric State Forecasting", "links": {"self": "https://zenodo.org/api/records/22250238", "self_html": "https://zenodo.org/records/22250238", "preview_html": "https://zenodo.org/records/22250238?preview=1", "doi": "https://doi.org/10.5281/zenodo.22250238", "self_doi": "https://doi.org/10.5281/zenodo.22250238", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22250238", "reserve_doi": "https://zenodo.org/api/records/22250238/draft/pids/doi", "parent": "https://zenodo.org/api/records/22250237", "parent_html": "https://zenodo.org/records/22250237", "parent_doi": "https://doi.org/10.5281/zenodo.22250237", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22250237", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22250238/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22250238/sequence/default", "files": "https://zenodo.org/api/records/22250238/files", "media_files": "https://zenodo.org/api/records/22250238/media-files", "latest": "https://zenodo.org/api/records/22250238/versions/latest", "latest_html": "https://zenodo.org/records/22250238/latest", "versions": "https://zenodo.org/api/records/22250238/versions", "draft": "https://zenodo.org/api/records/22250238/draft", "access_links": "https://zenodo.org/api/records/22250238/access/links", "access_grants": "https://zenodo.org/api/records/22250238/access/grants", "access_users": "https://zenodo.org/api/records/22250238/access/users", "access_request": "https://zenodo.org/api/records/22250238/access/request", "access": "https://zenodo.org/api/records/22250238/access", "communities": "https://zenodo.org/api/records/22250238/communities", "communities-suggestions": "https://zenodo.org/api/records/22250238/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/22250238/request-deletion", "file_modification": "https://zenodo.org/api/records/22250238/file-modification", "quota_increase": "https://zenodo.org/api/records/22250238/quota-increase", "requests": "https://zenodo.org/api/records/22250238/requests"}, "updated": "2026-09-02T09:42:32.865083+00:00", "recid": "22250238", "revision": 3, "files": [{"id": "6c338e33-823d-4289-9c00-4b7c187bac70", "key": "static.zip", "size": 2378058, "checksum": "md5:11c1f8f7bd2295d765151a2d0f88d028", "links": {"self": "https://zenodo.org/api/records/22250238/files/static.zip/content"}}, {"id"